# Config para correr contra los EMULADORES (npm run dev:emulador). No es secreta ni toca producción.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-kiva.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-kiva
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
